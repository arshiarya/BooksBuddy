{
  "name": "booksbuddy",
  "version": "1.0.0",
  "description": "Community-Based Virtual Library Platform",
  "private": true,
  "scripts": {
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
